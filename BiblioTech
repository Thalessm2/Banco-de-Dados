CREATE PROCEDURE sp_CadastrarFornecedor (
    IN pSupplierName VARCHAR(100),
    IN pContactName  VARCHAR(100),
    IN pEmail        VARCHAR(100),
    IN pPhone        VARCHAR(20),
    IN pCountry      VARCHAR(50),
    IN pState        VARCHAR(50),
    IN pCity         VARCHAR(50),
    IN pAddress      VARCHAR(150),
    IN pPostalCode   VARCHAR(10)
)

BEGIN
    DECLARE vExiste INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Erro inesperado ao cadastrar fornecedor. Operação revertida.';
    END;

    SELECT COUNT(*) INTO vExiste
    FROM Supplier
    WHERE Email = pEmail OR Phone = pPhone;

    IF vExiste > 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Já existe um fornecedor cadastrado com esse e-mail ou telefone.';
    ELSE
        START TRANSACTION;
            INSERT INTO Supplier (SupplierName, ContactName, Email, Phone, Country, State, City, Address, PostalCode)
            VALUES (pSupplierName, pContactName, pEmail, pPhone, pCountry, pState, pCity, pAddress, pPostalCode);
        COMMIT;
    END IF;
END $$
DELIMITER ;


