CREATE DATABASE BiblioTech;
USE BiblioTech;

CREATE TABLE Supplier (
SupplierID INT PRIMARY KEY AUTO_INCREMENT,
SupplierName VARCHAR (100) NOT NULL,
ContactName VARCHAR (100) NOT NULL,
Email VARCHAR (100) NOT NULL,
CONSTRAINT uc_email UNIQUE (Email),
Phone VARCHAR (20) NOT NULL,
CONSTRAINT uc_phone UNIQUE (Phone),
Country VARCHAR (50) NOT NULL,
State VARCHAR (50) NOT NULL,
City VARCHAR (50) NOT NULL,
Address VARCHAR (150) NOT NULL,
PostalCode VARCHAR (10) NOT NULL
);

CREATE TABLE Shippers (
ShippersID INT PRIMARY KEY AUTO_INCREMENT,
CarrierName VARCHAR (100) NOT NULL,
ContactName VARCHAR (100) NOT NULL,
Email VARCHAR (100) NOT NULL,
CONSTRAINT uc_email UNIQUE (Email),
Phone VARCHAR (20) NOT NULL,
CONSTRAINT uc_phone UNIQUE (Phone),
Country VARCHAR (50) NOT NULL,
State VARCHAR (50) NOT NULL,
City VARCHAR (50) NOT NULL,
Address VARCHAR (150) NOT NULL,
PostalCode VARCHAR (10) NOT NULL
);

CREATE TABLE Inventory (
InventoryID  INT PRIMARY KEY AUTO_INCREMENT,
Categories VARCHAR (77) NOT NULL,
Book VARCHAR (120) NOT NULL,
Authors VARCHAR (150) NOT NULL,
Publisher VARCHAR (200) NOT NULL,
Quantity INT NOT NULL,
SupplierID INT,
ShippersID INT,
    FOREIGN KEY (SupplierID)
    REFERENCES Supplier(SupplierID),
    FOREIGN KEY (ShippersID)
    REFERENCES Shippers(ShippersID)
);


CREATE TABLE Customer (
CustomerID INT PRIMARY KEY AUTO_INCREMENT,
CPF VARCHAR (20) UNIQUE NOT NULL,
Phone VARCHAR (20) UNIQUE NOT NULL,
Email VARCHAR (200) UNIQUE NOT NULL,
NameCustomer VARCHAR (200) NOT NULL,
DateOfBirth DATE NOT NULL
);

CREATE TABLE Employee (
EmployeeID INT PRIMARY KEY AUTO_INCREMENT,
EmployeeName VARCHAR (200) NOT NULL,
CPF VARCHAR (20) UNIQUE NOT NULL,
Phone VARCHAR (20) UNIQUE NOT NULL,
Email VARCHAR (200) UNIQUE NOT NULL,
DateOfBirth DATE NOT NULL,
ResumeEmployee VARCHAR (300) NOT NULL,
InventoryID INT,
CustomerID INT,
    FOREIGN KEY (InventoryID) 
    REFERENCES Inventory (InventoryID),
        FOREIGN KEY (CustomerID) 
    REFERENCES Customer (CustomerID)

);

CREATE TABLE BookCopyCondition (
BookCopyConditionID INT PRIMARY KEY AUTO_INCREMENT,
InspectionDate DATE NOT NULL,
ConservationStatus VARCHAR (30) NOT NULL,
DamageDescription VARCHAR (250),
ActionTaken VARCHAR (150),
AvailabilityStatus VARCHAR (40) NOT NULL,
EmployeeID INT,
    FOREIGN KEY (EmployeeID) 
    REFERENCES Employee(EmployeeID)
);

CREATE TABLE PhysicalLoan (
PhysicalLoanID INT PRIMARY KEY AUTO_INCREMENT,
LoanDate DATE NOT NULL,
DueDate DATE NOT NULL,
ReturnDate DATE,
LoanStatus VARCHAR (50) NOT NULL,
EmployeeID INT,
    FOREIGN KEY (EmployeeID) 
    REFERENCES Employee(EmployeeID)
);

CREATE TABLE DigitalLoan (
DigitalLoanID INT PRIMARY KEY AUTO_INCREMENT,
LoanDate DATE NOT NULL,
ExpirationDate DATE NOT NULL,
AccessStatus VARCHAR (50) NOT NULL,
EmployeeID INT,
    FOREIGN KEY (EmployeeID) 
    REFERENCES Employee(EmployeeID)
);

CREATE TABLE LateFee (
LateFeeID INT PRIMARY KEY AUTO_INCREMENT,
DaysLate INT NOT NULL,
FineAmount DECIMAL (10,2) NOT NULL,
PaymentStatus VARCHAR (20) NOT NULL,
PaymentDate DATE,
PhysicalLoanID INT,
    FOREIGN KEY (PhysicalLoanID)
    REFERENCES PhysicalLoan(PhysicalLoanID)
);

ALTER TABLE Supplier
ADD RegistrationDate DATE NOT NULL;

ALTER TABLE Shippers
ADD DeliveryType VARCHAR(50) NOT NULL;

ALTER TABLE Inventory
ADD ShelfLocation VARCHAR(50) NOT NULL;

ALTER TABLE Customer
ADD RegistrationDate DATE NOT NULL, ADD PasswordCustomer VARCHAR(150) NOT NULL ;

ALTER TABLE Employee
ADD HireDate DATE NOT NULL, ADD Position VARCHAR (100) NOT NULL, ADD PasswordCustomer VARCHAR(150) NOT NULL ;

ALTER TABLE BookCopyCondition
ADD InspectionNotes VARCHAR(300);

ALTER TABLE PhysicalLoan
ADD RenewalCount INT NOT NULL DEFAULT 0;

ALTER TABLE DigitalLoan
ADD DownloadLimit INT NOT NULL DEFAULT 3;

ALTER TABLE LateFee
ADD PaymentMethod VARCHAR(50);

