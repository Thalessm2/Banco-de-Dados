CREATE PROCEDURE sp_CadastrarCliente (
    IN pCPF          VARCHAR(20),
    IN pPhone        VARCHAR(20),
    IN pEmail        VARCHAR(200),
    IN pNameCustomer VARCHAR(200),
    IN pDateOfBirth  DATE
)

BEGIN
    DECLARE vIdade INT;
    DECLARE vExiste INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Erro inesperado ao cadastrar cliente. Operação revertida.';
    END;

    SET vIdade = TIMESTAMPDIFF(YEAR, pDateOfBirth, CURDATE());

    SELECT COUNT(*) INTO vExiste
    FROM Customer
    WHERE CPF = pCPF OR Phone = pPhone OR Email = pEmail;

    IF vIdade < 16 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Cliente deve ter no mínimo 16 anos para se cadastrar.';
    ELSEIF vExiste > 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Já existe um cliente cadastrado com esse CPF, telefone ou e-mail.';
    ELSE
        START TRANSACTION;
            INSERT INTO Customer (CPF, Phone, Email, NameCustomer, DateOfBirth)
            VALUES (pCPF, pPhone, pEmail, pNameCustomer, pDateOfBirth);
        COMMIT;
    END IF;
END $$
