CREATE PROCEDURE sp_AtualizarEstoque (
    IN pInventoryID INT,
    IN pQuantidade  INT,
    IN pTipoOperacao VARCHAR(10) -- 'ENTRADA' ou 'SAIDA'
)

BEGIN
    DECLARE vQuantidadeAtual INT DEFAULT 0;
    DECLARE vExisteInventario INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Erro inesperado ao atualizar estoque. Operação revertida.';
    END;

    START TRANSACTION;

        SELECT COUNT(*), IFNULL(MAX(Quantity), 0)
            INTO vExisteInventario, vQuantidadeAtual
        FROM Inventory
        WHERE InventoryID = pInventoryID
        FOR UPDATE;

        IF vExisteInventario = 0 THEN
            ROLLBACK;
            SIGNAL SQLSTATE '45000'
                SET MESSAGE_TEXT = 'Item de inventário não encontrado.';

        ELSEIF pTipoOperacao = 'SAIDA' THEN
            IF vQuantidadeAtual < pQuantidade THEN
                ROLLBACK;
                SIGNAL SQLSTATE '45000'
                    SET MESSAGE_TEXT = 'Quantidade insuficiente em estoque para essa saída.';
            ELSE
                UPDATE Inventory
                SET Quantity = Quantity - pQuantidade
                WHERE InventoryID = pInventoryID;
                COMMIT;
            END IF;

        ELSEIF pTipoOperacao = 'ENTRADA' THEN
            UPDATE Inventory
            SET Quantity = Quantity + pQuantidade
            WHERE InventoryID = pInventoryID;
            COMMIT;

        ELSE
            ROLLBACK;
            SIGNAL SQLSTATE '45000'
                SET MESSAGE_TEXT = 'Tipo de operação inválido. Use ENTRADA ou SAIDA.';
        END IF;

END $$
DELIMITER ;


