CREATE PROCEDURE sp_VincularFuncionarioInventario (
    IN pEmployeeID  INT,
    IN pInventoryID INT
)

BEGIN
    DECLARE vExisteFuncionario INT DEFAULT 0;
    DECLARE vExisteInventario  INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Erro inesperado ao vincular funcionário ao inventário.';
    END;

    SELECT COUNT(*) INTO vExisteFuncionario
    FROM Employee WHERE EmployeeID = pEmployeeID;

    SELECT COUNT(*) INTO vExisteInventario
    FROM Inventory WHERE InventoryID = pInventoryID;

    IF vExisteFuncionario = 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Funcionário não encontrado.';
    ELSEIF vExisteInventario = 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Item de inventário não encontrado.';
    ELSE
        START TRANSACTION;
            UPDATE Employee
            SET InventoryID = pInventoryID
            WHERE EmployeeID = pEmployeeID;
        COMMIT;
    END IF;
END $$
