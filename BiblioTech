CREATE PROCEDURE sp_RealizarEmprestimoFisico (
    IN pCustomerID  INT,
    IN pEmployeeID  INT,
    IN pInventoryID INT,
    IN pLoanDate    DATE,
    IN pDueDate     DATE
)

BEGIN
    DECLARE vQuantidadeDisponivel INT DEFAULT 0;
    DECLARE vExisteCliente        INT DEFAULT 0;
    DECLARE vEmprestimosAtivos    INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Erro inesperado ao registrar empréstimo. Operação revertida.';
    END;

    START TRANSACTION;

        SELECT Quantity INTO vQuantidadeDisponivel
        FROM Inventory
        WHERE InventoryID = pInventoryID
        FOR UPDATE;

        SELECT COUNT(*) INTO vExisteCliente
        FROM Customer WHERE CustomerID = pCustomerID;

        -- Subquery: quantos empréstimos ativos (não devolvidos) o cliente já possui
        SELECT COUNT(*) INTO vEmprestimosAtivos
        FROM PhysicalLoan pl
        WHERE pl.CustomerID = pCustomerID
          AND pl.ReturnDate IS NULL;

        IF vExisteCliente = 0 THEN
            ROLLBACK;
            SIGNAL SQLSTATE '45000'
                SET MESSAGE_TEXT = 'Cliente não encontrado.';

        ELSEIF vQuantidadeDisponivel IS NULL OR vQuantidadeDisponivel < 1 THEN
            ROLLBACK;
            SIGNAL SQLSTATE '45000'
                SET MESSAGE_TEXT = 'Sem exemplares disponíveis para empréstimo.';

        ELSEIF vEmprestimosAtivos >= 5 THEN
            ROLLBACK;
            SIGNAL SQLSTATE '45000'
                SET MESSAGE_TEXT = 'Cliente já atingiu o limite de 5 empréstimos ativos.';

        ELSE
            INSERT INTO PhysicalLoan (LoanDate, DueDate, ReturnDate, LoanStatus, CustomerID, EmployeeID)
            VALUES (pLoanDate, pDueDate, NULL, 'Em Andamento', pCustomerID, pEmployeeID);

            UPDATE Inventory
            SET Quantity = Quantity - 1
            WHERE InventoryID = pInventoryID;

            COMMIT;
        END IF;

END $$
DELIMITER ;


DELIMITER $$

CREATE PROCEDURE sp_RegistrarDevolucaoFisica (
    IN pPhysicalLoanID INT,
    IN pInventoryID     INT,
    IN pReturnDate      DATE
)

BEGIN
    DECLARE vDueDate      DATE;
    DECLARE vLoanStatus   VARCHAR(50);
    DECLARE vExisteLoan   INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Erro inesperado ao registrar devolução.';
    END;

    SELECT COUNT(*), MAX(DueDate) INTO vExisteLoan, vDueDate
    FROM PhysicalLoan
    WHERE PhysicalLoanID = pPhysicalLoanID;

    IF vExisteLoan = 0 THEN
        SIGNAL SQLSTATE '45000'
            SET MESSAGE_TEXT = 'Empréstimo não encontrado.';
    ELSE
        IF pReturnDate > vDueDate THEN
            SET vLoanStatus = 'Devolvido com Atraso';
        ELSE
            SET vLoanStatus = 'Devolvido no Prazo';
        END IF;

        START TRANSACTION;
            UPDATE PhysicalLoan
            SET ReturnDate = pReturnDate,
                LoanStatus = vLoanStatus
            WHERE PhysicalLoanID = pPhysicalLoanID;

            UPDATE Inventory
            SET Quantity = Quantity + 1
            WHERE InventoryID = pInventoryID;
        COMMIT;
    END IF;
END $$
DELIMITER ;
