-- 1. Listar disciplinas com professores
-- Regra: mostrar qual professor ministra cada disciplina

DELIMITER $$

CREATE PROCEDURE DisciplinasProfessores()
BEGIN
    SELECT d.DisciplinasID, d.NomeDisciplina, p.Nome AS Professor
    FROM Disciplinas d
    INNER JOIN Professores p ON d.ProfessorID = p.ProfessoresID;
END $$

DELIMITER ;

-- 2. Listar notas com professores
-- Regra: identificar quem lançou a nota

DELIMITER $$

CREATE PROCEDURE NotasProfessores()
BEGIN
    SELECT n.NotasID, p.Nome AS Professor, n.NotaFinal
    FROM Notas n
    INNER JOIN Professores p ON n.ProfessoresID = p.ProfessoresID;
END $$

DELIMITER ;

-- 3. Listar notas com dados da secretaria
-- Regra: integrar notas com setor financeiro/acadêmico

DELIMITER $$

CREATE PROCEDURE NotasSecretaria()
BEGIN
    SELECT n.NotasID, n.NotaFinal, s.Mensalidade, s.Turno
    FROM Notas n
    INNER JOIN Secretaria s ON n.SecretariaID = s.SecretariaID;
END $$

DELIMITER ;

-- 4. Listar universidade com dados da secretaria
-- Regra: integração institucional

DELIMITER $$

CREATE PROCEDURE UniversidadeSecretaria()
BEGIN
    SELECT u.Nome AS Universidade, u.CNPJ, s.Mensalidade, s.Turno
    FROM Universidade u
    INNER JOIN Secretaria s ON u.SecretariaID = s.SecretariaID;
END $$

DELIMITER ;

-- 5. Listar disciplinas + professor + salário
-- Regra: visão administrativa completa

DELIMITER $$

CREATE PROCEDURE DisciplinasSalarios()
BEGIN
    SELECT d.NomeDisciplina, p.Nome, p.Salario
    FROM Disciplinas d
    INNER JOIN Professores p ON d.ProfessorID = p.ProfessoresID;
END $$

DELIMITER ;

-- 6. Listar notas completas (professor + secretaria)
-- Regra: visão geral do lançamento de notas

DELIMITER $$

CREATE PROCEDURE NotasCompletas()
BEGIN
    SELECT n.NotasID, p.Nome AS Professor, s.Turno, n.NotaFinal
    FROM Notas n
    INNER JOIN Professores p ON n.ProfessoresID = p.ProfessoresID
    INNER JOIN Secretaria s ON n.SecretariaID = s.SecretariaID;
END $$

DELIMITER ;

-- 7. Média de notas por professor
-- Regra: análise de desempenho docente

DELIMITER $$

CREATE PROCEDURE MediaPorProfessor()
BEGIN
    SELECT p.Nome, AVG(n.NotaFinal) AS Media
    FROM Notas n
    INNER JOIN Professores p ON n.ProfessoresID = p.ProfessoresID
    GROUP BY p.ProfessoresID;
END $$

DELIMITER ;

