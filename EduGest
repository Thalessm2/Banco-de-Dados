CREATE DATABASE EduGest;
USE EduGest;

CREATE TABLE Professores (
    ProfessoresID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(40) NOT NULL,
    DataNascimento DATE NOT NULL,
    Telefone VARCHAR(20) NOT NULL,
    Endereco VARCHAR(40),
    Email VARCHAR(40),
    CPF VARCHAR(11) NOT NULL UNIQUE
);

CREATE TABLE Aluno (
    AlunoID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(50) NOT NULL,
    DataNascimento DATE NOT NULL,
    CPF VARCHAR(11) NOT NULL UNIQUE,
    Email VARCHAR(70)
);

CREATE TABLE Matriculas (
    MatriculaID INT PRIMARY KEY AUTO_INCREMENT,
    NomeDoAluno VARCHAR(40) NOT NULL,
    CPFDoAluno VARCHAR(11) NOT NULL,
    Email VARCHAR(40),
    Endereco VARCHAR(40)
);

CREATE TABLE Disciplinas (
    DisciplinasID INT PRIMARY KEY AUTO_INCREMENT,
    ProfessorID INT NOT NULL,
    FOREIGN KEY (ProfessorID) REFERENCES Professores(ProfessoresID)
);

CREATE TABLE Secretaria (
    SecretariaID INT PRIMARY KEY AUTO_INCREMENT,
    DisciplinasID INT NOT NULL,
    Mensalidade DECIMAL(10,2),
    FOREIGN KEY (DisciplinasID) REFERENCES Disciplinas(DisciplinasID)
);

CREATE TABLE Notas (
    NotasID INT PRIMARY KEY AUTO_INCREMENT,
    ProfessoresID INT NOT NULL,
    SecretariaID INT NOT NULL,
    FOREIGN KEY (ProfessoresID) REFERENCES Professores(ProfessoresID),
    FOREIGN KEY (SecretariaID) REFERENCES Secretaria(SecretariaID)
);

CREATE TABLE Universidade (
    UniversidadeID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(40) NOT NULL,
    Endereco VARCHAR(40) NOT NULL,
    CNPJ VARCHAR(14) UNIQUE NOT NULL,
    SecretariaID INT NOT NULL,
    FOREIGN KEY (SecretariaID) REFERENCES Secretaria(SecretariaID)
);

ALTER TABLE Professores
ADD Salario DECIMAL(10,2);

ALTER TABLE Aluno
ADD Cidade VARCHAR(40);

ALTER TABLE Matriculas
ADD DataMatricula DATE;

ALTER TABLE Disciplinas
ADD NomeDisciplina VARCHAR(50);

ALTER TABLE Secretaria
ADD Turno VARCHAR(20);

ALTER TABLE Notas
ADD NotaFinal DECIMAL(4,2);

ALTER TABLE Universidade
ADD Telefone VARCHAR(20);

