-- 1. Listar vendas completas
-- Regra: integrar cliente, funcionário e carro na mesma consulta

DELIMITER $$

CREATE PROCEDURE VendasCompletas()
BEGIN
    SELECT v.VendasID,
           f.PrimeiroNome, f.SegundoNome AS Funcionario,
           c.Nome AS Cliente,
           ca.Modelo, ca.Marca
    FROM Vendas v
    INNER JOIN Funcionarios f ON v.FuncionariosID = f.FuncionariosID
    INNER JOIN Clientes c ON v.ClientesID = c.ClientesID
    INNER JOIN Carros ca ON v.CarrosID = ca.CarrosID;
END $$

DELIMITER ;

-- 2. Buscar vendas por cliente
-- Regra: histórico de compras do cliente

DELIMITER $$

CREATE PROCEDURE VendasPorCliente(IN idCliente INT)
BEGIN
    SELECT v.VendasID, ca.Modelo, ca.Marca
    FROM Vendas v
    INNER JOIN Carros ca ON v.CarrosID = ca.CarrosID
    WHERE v.ClientesID = idCliente;
END $$

DELIMITER ;

-- 3. Funcionários e suas vendas
-- Regra: acompanhar desempenho dos vendedores

DELIMITER $$

CREATE PROCEDURE FuncionariosVendas()
BEGIN
    SELECT f.PrimeiroNome, f.SegundoNome, COUNT(v.VendasID) AS TotalVendas
    FROM Funcionarios f
    INNER JOIN Vendas v ON f.FuncionariosID = v.FuncionariosID
    GROUP BY f.FuncionariosID;
END $$

DELIMITER ;

-- 4. Test drives agendados com cliente e carro
-- Regra: controle de agendamentos

DELIMITER $$

CREATE PROCEDURE TestDrives()
BEGIN
    SELECT t.TestDriveID, t.DataAgendamento,
           c.Nome AS Cliente,
           ca.Modelo
    FROM TestDrive t
    INNER JOIN Clientes c ON t.ClientesID = c.ClientesID
    INNER JOIN Carros ca ON t.CarrosID = ca.CarrosID;
END $$

DELIMITER ;

-- 5. Peças e fornecedores
-- Regra: rastrear origem das peças

DELIMITER $$

CREATE PROCEDURE PecasFornecedores()
BEGIN
    SELECT p.PecasID, f.Nome AS Fornecedor, f.CNPJ
    FROM Pecas p
    INNER JOIN Fornecedores f ON p.FornecedoresID = f.FornecedoresID;
END $$

DELIMITER ;

-- 6. Listar carros vendidos
-- Regra: identificar veículos já comercializados

DELIMITER $$

CREATE PROCEDURE CarrosVendidos()
BEGIN
    SELECT DISTINCT ca.Modelo, ca.Marca
    FROM Vendas v
    INNER JOIN Carros ca ON v.CarrosID = ca.CarrosID;
END $$

DELIMITER ;

-- 7. Quantidade de test drives por carro
-- Regra: identificar carros mais procurados

DELIMITER $$

CREATE PROCEDURE PopularidadeCarros()
BEGIN
    SELECT ca.Modelo, COUNT(t.TestDriveID) AS TotalTestDrive
    FROM TestDrive t
    INNER JOIN Carros ca ON t.CarrosID = ca.CarrosID
    GROUP BY ca.CarrosID;
END $$

DELIMITER ;

