CREATE DATABASE AutoPrime;
USE AutoPrime;

CREATE TABLE Fornecedores (
    FornecedoresID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(40) NOT NULL,
    Endereco VARCHAR(40) NOT NULL,
    Cidade VARCHAR(40) NOT NULL,
    Email VARCHAR(40) NOT NULL
);

CREATE TABLE Funcionarios (
    FuncionariosID INT PRIMARY KEY AUTO_INCREMENT,
    SegundoNome VARCHAR(40) NOT NULL,
    DataNascimento DATE NOT NULL,
    Foto VARCHAR(150),
    Nota VARCHAR(200)
);

CREATE TABLE Clientes (
    ClientesID INT PRIMARY KEY AUTO_INCREMENT,
    Telefone VARCHAR(20) NOT NULL,
    Endereco VARCHAR(40) NOT NULL,
    Cidade VARCHAR(40) NOT NULL,
    Pais VARCHAR(40) NOT NULL
);

CREATE TABLE Carros (
    CarrosID INT PRIMARY KEY AUTO_INCREMENT,
    Modelo VARCHAR(40) NOT NULL,
    EstadoDoCarro VARCHAR(40) NOT NULL
);

CREATE TABLE Vendas (
    VendasID INT PRIMARY KEY AUTO_INCREMENT,
    FuncionariosID INT NOT NULL,
    ClientesID INT NOT NULL,
    CarrosID INT NOT NULL,
    FOREIGN KEY (FuncionariosID) REFERENCES Funcionarios(FuncionariosID),
    FOREIGN KEY (ClientesID) REFERENCES Clientes(ClientesID),
    FOREIGN KEY (CarrosID) REFERENCES Carros(CarrosID)
);

CREATE TABLE Pecas (
    PecasID INT PRIMARY KEY AUTO_INCREMENT,
    FornecedoresID INT,
    FOREIGN KEY (FornecedoresID) REFERENCES Fornecedores(FornecedoresID)
);

CREATE TABLE TestDrive (
    TestDriveID INT PRIMARY KEY AUTO_INCREMENT,
    DataAgendamento DATE,
    ClientesID INT,
    CarrosID INT,
    FOREIGN KEY (ClientesID) REFERENCES Clientes(ClientesID),
    FOREIGN KEY (CarrosID) REFERENCES Carros(CarrosID)
);

ALTER TABLE carros
ADD Documentacao VARCHAR(40) NOT NULL;

ALTER TABLE carros
ADD Marca VARCHAR(40) NOT NULL;

ALTER TABLE fornecedores
ADD CNPJ VARCHAR(14) UNIQUE NOT NULL;

ALTER TABLE fornecedores
ADD Telefone VARCHAR(20) NOT NULL;

ALTER TABLE pecas
ADD PecasDeSubstituicao VARCHAR(40);

ALTER TABLE funcionarios
ADD PrimeiroNome VARCHAR(40) NOT NULL;

ALTER TABLE clientes
ADD Nome VARCHAR(40) NOT NULL;

