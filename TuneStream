)

BEGIN
    DECLARE v_EmailCount INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_Message = 'Erro ao cadastrar artista. Operação revertida.';
    END;

    SELECT COUNT(*) INTO v_EmailCount FROM Artist WHERE Email = p_Email;

    START TRANSACTION;

    IF v_EmailCount > 0 THEN
