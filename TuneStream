DROP PROCEDURE IF EXISTS sp_CreateSubscription$$
CREATE PROCEDURE sp_CreateSubscription(
    IN p_UserID INT,
    IN p_PlanID INT,
    OUT p_Message VARCHAR(255)
)

BEGIN
    DECLARE v_ActiveCount INT DEFAULT 0;
    DECLARE v_UserExists INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_Message = 'Erro ao criar assinatura. Operação revertida.';
    END;

    SELECT COUNT(*) INTO v_UserExists FROM _User WHERE UserID = p_UserID;
    SELECT COUNT(*) INTO v_ActiveCount
    FROM Subscription
    WHERE UserID = p_UserID AND StatusSubscriptions = 'ativa';

    START TRANSACTION;

    IF v_UserExists = 0 THEN
        SET p_Message = 'Erro: usuário não encontrado.';
        ROLLBACK;
    ELSE
        IF v_ActiveCount > 0 THEN
            UPDATE Subscription
            SET StatusSubscriptions = 'cancelada', EndDate = CURDATE(), AutoRenew = FALSE
            WHERE UserID = p_UserID AND StatusSubscriptions = 'ativa';
        END IF;

        INSERT INTO Subscription (StartDate, StatusSubscriptions, UserID, PlanID, AutoRenew)
        VALUES (CURDATE(), 'ativa', p_UserID, p_PlanID, TRUE);

        COMMIT;
        SET p_Message = CONCAT('Assinatura criada com sucesso. ID: ', LAST_INSERT_ID());
    END IF;
END$$


DROP PROCEDURE IF EXISTS sp_ProcessPayment$$
CREATE PROCEDURE sp_ProcessPayment(
    IN p_SubscriptionID INT,
    IN p_PaymentMethod VARCHAR(30),
    IN p_TransactionReference VARCHAR(100),
    OUT p_Message VARCHAR(255)
)

BEGIN
    DECLARE v_PlanPrice DECIMAL(10,2);
    DECLARE v_SubStatus VARCHAR(30);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_Message = 'Erro ao processar pagamento. Operação revertida.';
    END;

    SELECT pl.Price, s.StatusSubscriptions
    INTO v_PlanPrice, v_SubStatus
    FROM Subscription s
    JOIN Plan pl ON pl.PlanID = s.PlanID
    WHERE s.SubscriptionID = p_SubscriptionID;

    START TRANSACTION;

    IF v_SubStatus IS NULL THEN
        SET p_Message = 'Erro: assinatura não encontrada.';
        ROLLBACK;
    ELSEIF v_SubStatus <> 'ativa' THEN
        SET p_Message = 'Erro: não é possível pagar uma assinatura inativa.';
        ROLLBACK;
    ELSE
        INSERT INTO Payment (Amount, PaymentMethod, PaymentDate, StatusPayments, SubscriptionID, TransactionReference)
        VALUES (v_PlanPrice, p_PaymentMethod, CURDATE(), 'aprovado', p_SubscriptionID, p_TransactionReference);

        UPDATE Subscription
        SET EndDate = DATE_ADD(CURDATE(), INTERVAL 1 MONTH)
        WHERE SubscriptionID = p_SubscriptionID;

        COMMIT;
        SET p_Message = CONCAT('Pagamento de R$ ', v_PlanPrice, ' processado com sucesso.');
    END IF;
END$$


DROP PROCEDURE IF EXISTS sp_AddSongToPlaylist$$
CREATE PROCEDURE sp_AddSongToPlaylist(
    IN p_PlaylistID INT,
    IN p_SongID INT,
    IN p_UserID INT,
    OUT p_Message VARCHAR(255)
)
BEGIN
    DECLARE v_AlreadyExists INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_Message = 'Erro ao adicionar música à playlist. Operação revertida.';
    END;

    SELECT COUNT(*) INTO v_AlreadyExists
    FROM PlaylistSongs
    WHERE PlaylistID = p_PlaylistID
      AND SongID = (SELECT SongID FROM Song WHERE SongID = p_SongID);

    START TRANSACTION;

    IF v_AlreadyExists > 0 THEN
        SET p_Message = 'Aviso: esta música já está na playlist.';
        ROLLBACK;
    ELSE
        INSERT INTO PlaylistSongs (DateAdded, PlaylistID, SongID, AddedByUserID)
        VALUES (CURDATE(), p_PlaylistID, p_SongID, p_UserID);

        UPDATE Playlist SET UpdatedAt = NOW() WHERE PlaylistID = p_PlaylistID;

        COMMIT;
        SET p_Message = 'Música adicionada à playlist com sucesso.';
    END IF;
END$$


DROP PROCEDURE IF EXISTS sp_LogPodcastPlayback$$
CREATE PROCEDURE sp_LogPodcastPlayback(
    IN p_UserID INT,
    IN p_EpisodeID INT,
    IN p_ListeningTime TIME,
    IN p_DeviceType VARCHAR(50),
    OUT p_Message VARCHAR(255)
)

BEGIN
    DECLARE v_EpisodeDuration TIME;
    DECLARE v_PodcastTitle VARCHAR(100);
    DECLARE v_CompletionStatus VARCHAR(20);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_Message = 'Erro ao registrar reprodução. Operação revertida.';
    END;

    SELECT e.Duration, p.Title INTO v_EpisodeDuration, v_PodcastTitle
    FROM Episode e
    JOIN Podcast p ON p.PodcastID = e.PodcastID
    WHERE e.EpisodeID = p_EpisodeID;

    START TRANSACTION;

    IF v_EpisodeDuration IS NULL THEN
        SET p_Message = 'Erro: episódio não encontrado.';
        ROLLBACK;
    ELSE
        IF p_ListeningTime >= v_EpisodeDuration THEN
            SET v_CompletionStatus = 'completo';
        ELSE
            SET v_CompletionStatus = 'parcial';
        END IF;

        INSERT INTO PodcastHistory (PlaybackDate, ListeningTime, UserID, EpisodeID, DeviceType)
        VALUES (NOW(), p_ListeningTime, p_UserID, p_EpisodeID, p_DeviceType);

        COMMIT;
        SET p_Message = CONCAT('Reprodução (', v_CompletionStatus, ') registrada no podcast "', v_PodcastTitle, '".');
    END IF;
END$$


DROP PROCEDURE IF EXISTS sp_CalculateAndPayRoyalties$$
CREATE PROCEDURE sp_CalculateAndPayRoyalties(
    IN p_ArtistID INT,
    IN p_ReferenceMonth DATE,
    IN p_TotalStreams INT,
    OUT p_Message VARCHAR(255)
)

BEGIN
    DECLARE v_Rate DECIMAL(6,4);
    DECLARE v_Amount DECIMAL(10,2);
    DECLARE v_ArtistExists INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_Message = 'Erro ao calcular royalties. Operação revertida.';
    END;

    SELECT COUNT(*) INTO v_ArtistExists FROM Artist WHERE ArtistID = p_ArtistID;

    START TRANSACTION;

    IF v_ArtistExists = 0 THEN
        SET p_Message = 'Erro: artista não encontrado.';
        ROLLBACK;
    ELSE
        IF p_TotalStreams >= 1000000 THEN
            SET v_Rate = 0.0040;
        ELSEIF p_TotalStreams >= 100000 THEN
            SET v_Rate = 0.0030;
        ELSE
            SET v_Rate = 0.0020;
        END IF;

        SET v_Amount = ROUND(p_TotalStreams * v_Rate, 2);

        INSERT INTO Royaltie (ReferenceMonth, TotalStreams, AmountPaid, PaymentDate, ArtistID, Notes)
        VALUES (p_ReferenceMonth, p_TotalStreams, v_Amount, CURDATE(), p_ArtistID,
                CONCAT('Cálculo automático com taxa de ', v_Rate, ' por stream'));

        COMMIT;
        SET p_Message = CONCAT('Royalties calculados e registrados: R$ ', v_Amount);
    END IF;
END$$


DROP PROCEDURE IF EXISTS sp_TogglePlaylistVisibility$$
CREATE PROCEDURE sp_TogglePlaylistVisibility(
    IN p_PlaylistID INT,
    OUT p_Message VARCHAR(255)
)

BEGIN
    DECLARE v_Exists INT DEFAULT 0;
    DECLARE v_CurrentVisibility BOOLEAN;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_Message = 'Erro ao alterar visibilidade da playlist. Operação revertida.';
    END;

    SELECT COUNT(*), MAX(Public) INTO v_Exists, v_CurrentVisibility
    FROM Playlist WHERE PlaylistID = p_PlaylistID;

    START TRANSACTION;

    IF v_Exists = 0 THEN
        SET p_Message = 'Erro: playlist não encontrada.';
        ROLLBACK;
    ELSE
        IF v_CurrentVisibility = TRUE THEN
            UPDATE Playlist SET Public = FALSE, UpdatedAt = NOW() WHERE PlaylistID = p_PlaylistID;
            SET p_Message = 'Playlist alterada para privada.';
        ELSE
            UPDATE Playlist SET Public = TRUE, UpdatedAt = NOW() WHERE PlaylistID = p_PlaylistID;
            SET p_Message = 'Playlist alterada para pública.';
        END IF;
        COMMIT;
    END IF;
END$$
DELIMITER ;
