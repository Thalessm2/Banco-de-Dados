CREATE DATABASE TuneStream;
USE TuneStream;

CREATE TABLE Plan (
PlanID INT AUTO_INCREMENT PRIMARY KEY,
PlanName ENUM ('free','premium') NOT NULL,
Price DECIMAL(10,2)
);

CREATE TABLE _User (
UserID INT AUTO_INCREMENT PRIMARY KEY,
UserName VARCHAR(100) NOT NULL,
Email VARCHAR(100) NOT NULL,
CONSTRAINT uc_email UNIQUE (Email),
UsersPassword VARCHAR(255) NOT NULL,
DateOfBirth DATE,
Phone VARCHAR(20),
CONSTRAINT uc_phone UNIQUE (Phone)
);

CREATE TABLE Artist (
ArtistID INT AUTO_INCREMENT PRIMARY KEY,
StageName VARCHAR(100) NOT NULL,
RealName VARCHAR(100),
Country VARCHAR(50),
MusicGenre ENUM('Pop','Rock','Hip Hop','Rap','R&B','Soul','Funk','Disco','Jazz','Blues','Country','Folk','Reggae','Ska','Dub','Dancehall','Latin','Salsa','Merengue','Bachata','Tango','Samba','Pagode','Forró','Sertanejo','MPB','Bossa Nova','Axé','Frevo','Maracatu','Gospel','Christian','Classical','Opera','Instrumental','Electronic','House','Deep House','Tech House','Techno','Trance','Progressive House','Drum and Bass','Dubstep','Hardstyle','EDM','Ambient','Lo-fi','Synthwave','New Age','K-Pop','J-Pop','C-Pop','Metal','Heavy Metal','Thrash Metal','Death Metal','Black Metal','Power Metal','Progressive Metal','Metalcore','Hard Rock','Punk','Pop Punk','Alternative Rock','Indie Rock','Grunge','Emo','Alternative','Indie','Psychedelic Rock','Glam Rock','Rockabilly','Bluegrass','Afrobeat','Afropop','Trap','Drill','Grime','Phonk','Reggaeton','Moombahton','World Music','Children','Holiday','Soundtrack','Anime','Game Soundtrack','Comedy','Spoken Word','Podcast','Other'),
Email VARCHAR(100) NOT NULL,
CONSTRAINT uc_email UNIQUE (Email),
Phone VARCHAR(20),
CONSTRAINT uc_phone UNIQUE (Phone)
);

CREATE TABLE Album (
AlbumID INT AUTO_INCREMENT PRIMARY KEY,
Title VARCHAR(100) NOT NULL,
ReleaseDate DATE,
Genre ENUM('Pop','Rock','Hip Hop','Rap','R&B','Soul','Funk','Disco','Jazz','Blues','Country','Folk','Reggae','Ska','Dub','Dancehall','Latin','Salsa','Merengue','Bachata','Tango','Samba','Pagode','Forró','Sertanejo','MPB','Bossa Nova','Axé','Frevo','Maracatu','Gospel','Christian','Classical','Opera','Instrumental','Electronic','House','Deep House','Tech House','Techno','Trance','Progressive House','Drum and Bass','Dubstep','Hardstyle','EDM','Ambient','Lo-fi','Synthwave','New Age','K-Pop','J-Pop','C-Pop','Metal','Heavy Metal','Thrash Metal','Death Metal','Black Metal','Power Metal','Progressive Metal','Metalcore','Hard Rock','Punk','Pop Punk','Alternative Rock','Indie Rock','Grunge','Emo','Alternative','Indie','Psychedelic Rock','Glam Rock','Rockabilly','Bluegrass','Afrobeat','Afropop','Trap','Drill','Grime','Phonk','Reggaeton','Moombahton','World Music','Children','Holiday','Soundtrack','Anime','Game Soundtrack','Comedy','Spoken Word','Podcast','Other')
);

CREATE TABLE Song (
SongID INT AUTO_INCREMENT PRIMARY KEY,
Title VARCHAR(100) NOT NULL,
Duration TIME,
Genre ENUM('Pop','Rock','Hip Hop','Rap','R&B','Soul','Funk','Disco','Jazz','Blues','Country','Folk','Reggae','Ska','Dub','Dancehall','Latin','Salsa','Merengue','Bachata','Tango','Samba','Pagode','Forró','Sertanejo','MPB','Bossa Nova','Axé','Frevo','Maracatu','Gospel','Christian','Classical','Opera','Instrumental','Electronic','House','Deep House','Tech House','Techno','Trance','Progressive House','Drum and Bass','Dubstep','Hardstyle','EDM','Ambient','Lo-fi','Synthwave','New Age','K-Pop','J-Pop','C-Pop','Metal','Heavy Metal','Thrash Metal','Death Metal','Black Metal','Power Metal','Progressive Metal','Metalcore','Hard Rock','Punk','Pop Punk','Alternative Rock','Indie Rock','Grunge','Emo','Alternative','Indie','Psychedelic Rock','Glam Rock','Rockabilly','Bluegrass','Afrobeat','Afropop','Trap','Drill','Grime','Phonk','Reggaeton','Moombahton','World Music','Children','Holiday','Soundtrack','Anime','Game Soundtrack','Comedy','Spoken Word','Podcast','Other')
);

CREATE TABLE Podcast (
PodcastID INT AUTO_INCREMENT PRIMARY KEY,
Title VARCHAR(100),
DescriptionPodcasts TEXT,
Category VARCHAR(50),
Creator VARCHAR(100)
);

CREATE TABLE Episode(
EpisodeID INT AUTO_INCREMENT PRIMARY KEY,
Title VARCHAR(100),
DescriptionEpisodes TEXT,
Duration TIME,
PublicationDate DATE,
PodcastID INT,
    FOREIGN KEY (PodcastID)
     REFERENCES Podcast(PodcastID)
);

CREATE TABLE Playlist (
PlaylistID INT AUTO_INCREMENT PRIMARY KEY,
PlaylistName VARCHAR(100),
CreationDate DATE,
Public BOOLEAN,
UserID INT,
    FOREIGN KEY (UserID)
    REFERENCES _User(UserID)
);

CREATE TABLE PlaylistSongs (
PlaylistSongsID INT AUTO_INCREMENT PRIMARY KEY,
DateAdded DATE,
PlaylistID INT,
SongID INT,
    FOREIGN KEY (PlaylistID)
     REFERENCES Playlist(PlaylistID),
    FOREIGN KEY (SongID)
     REFERENCES Song(SongID)
);

CREATE TABLE PodcastHistory (
HistoryID INT AUTO_INCREMENT PRIMARY KEY,
PlaybackDate DATETIME,
ListeningTime TIME,
UserID INT,
EpisodeID INT,
    FOREIGN KEY (UserID)
     REFERENCES _User(UserID),
    FOREIGN KEY (EpisodeID)
     REFERENCES Episode(EpisodeID)
);

CREATE TABLE Subscription (
SubscriptionID INT AUTO_INCREMENT PRIMARY KEY,
StartDate DATE,
EndDate DATE,
StatusSubscriptions VARCHAR(30),
UserID INT,
PlanID INT,
    FOREIGN KEY (UserID)
     REFERENCES _User(UserID),
    FOREIGN KEY (PlanID)
     REFERENCES Plan(PlanID)
);

CREATE TABLE Payment (
PaymentID INT AUTO_INCREMENT PRIMARY KEY,
Amount DECIMAL(10,2),
PaymentMethod VARCHAR(30),
PaymentDate DATE,
StatusPayments VARCHAR(30),
SubscriptionID INT,
    FOREIGN KEY (SubscriptionID)
    REFERENCES Subscription(SubscriptionID)
);

CREATE TABLE Royaltie (
RoyaltyID INT AUTO_INCREMENT PRIMARY KEY,
ReferenceMonth DATE,
TotalStreams INT,
AmountPaid DECIMAL(10,2),
PaymentDate DATE,
ArtistID INT,
    FOREIGN KEY (ArtistID)
    REFERENCES Artist(ArtistID)
);

ALTER TABLE Plan
ADD COLUMN PlanDescription VARCHAR(255) NULL;

ALTER TABLE _User
ADD COLUMN Country VARCHAR(50) NULL;

ALTER TABLE Artist
ADD COLUMN Biography TEXT NULL;

ALTER TABLE Album
ADD COLUMN AlbumDescription TEXT NULL;

ALTER TABLE Song
ADD COLUMN IsExplicit BOOLEAN NOT NULL DEFAULT FALSE;

ALTER TABLE Podcast
ADD COLUMN Language VARCHAR(30) NULL;

ALTER TABLE Episode
ADD COLUMN EpisodeNumber INT NULL;

ALTER TABLE Playlist
ADD COLUMN UpdatedAt DATETIME NULL;

ALTER TABLE PlaylistSongs
ADD COLUMN AddedByUserID INT NULL;

ALTER TABLE PodcastHistory
ADD COLUMN DeviceType VARCHAR(50) NULL;

ALTER TABLE Subscription
ADD COLUMN AutoRenew BOOLEAN NOT NULL DEFAULT TRUE;

ALTER TABLE Payment
ADD COLUMN TransactionReference VARCHAR(100) NULL;

ALTER TABLE Royaltie
ADD COLUMN Notes VARCHAR(255) NULL;

