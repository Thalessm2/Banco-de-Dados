DROP PROCEDURE IF EXISTS sp_RegisterUser$$
CREATE PROCEDURE sp_RegisterUser(
    IN p_UserName VARCHAR(100),
    IN p_Email VARCHAR(100),
    IN p_Password VARCHAR(255),
    IN p_DateOfBirth DATE,
    IN p_Phone VARCHAR(20),
    IN p_Country VARCHAR(50),
    OUT p_Message VARCHAR(255)
)

BEGIN
    DECLARE v_EmailCount INT DEFAULT 0;
    DECLARE v_PhoneCount INT DEFAULT 0;
    DECLARE v_NewUserID INT;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        SET p_Message = 'Erro ao cadastrar usuário. Operação revertida.';
    END;

    SELECT COUNT(*) INTO v_EmailCount FROM _User WHERE Email = p_Email;
    SELECT COUNT(*) INTO v_PhoneCount FROM _User WHERE Phone = p_Phone;

    START TRANSACTION;

    IF v_EmailCount > 0 THEN
        SET p_Message = 'Erro: e-mail já cadastrado.';
        ROLLBACK;
    ELSEIF v_PhoneCount > 0 THEN
        SET p_Message = 'Erro: telefone já cadastrado.';
        ROLLBACK;
    ELSE
        INSERT INTO _User (UserName, Email, UsersPassword, DateOfBirth, Phone, Country)
        VALUES (p_UserName, p_Email, p_Password, p_DateOfBirth, p_Phone, p_Country);

        SET v_NewUserID = LAST_INSERT_ID();

        -- Assina automaticamente o plano gratuito
        INSERT INTO Subscription (StartDate, StatusSubscriptions, UserID, PlanID, AutoRenew)
        SELECT CURDATE(), 'ativa', v_NewUserID, PlanID, FALSE
        FROM Plan WHERE PlanName = 'free' LIMIT 1;

        COMMIT;
        SET p_Message = CONCAT('Usuário cadastrado com sucesso. ID: ', v_NewUserID);
    END IF;
END$$


