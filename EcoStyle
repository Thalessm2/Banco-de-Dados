CREATE DATABASE EcoStyle;
USE EcoStyle;

CREATE TABLE Fornecedores (
    FornecedoresID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(40) NOT NULL,
    Telefone VARCHAR(20) NOT NULL,
    Endereco VARCHAR(40) NOT NULL,
    Cidade VARCHAR(40) NOT NULL,
    CNPJ VARCHAR(14) UNIQUE NOT NULL,
    Email VARCHAR(40) NOT NULL
);

CREATE TABLE Clientes (
    ClientesID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(40) NOT NULL,
    Telefone VARCHAR(20) NOT NULL,
    Endereco VARCHAR(40) NOT NULL,
    Cidade VARCHAR(40) NOT NULL,
    Pais VARCHAR(40) NOT NULL
);

CREATE TABLE Transportadora (
    TransportadoraID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(40) NOT NULL,
    Telefone VARCHAR(20) NOT NULL,
    Devolucao VARCHAR(500)
);

CREATE TABLE Produtos (
    ProdutosID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(40) NOT NULL,
    Quantidade INT NOT NULL,
    Preco DECIMAL(10,2) NOT NULL,
    FornecedoresID INT,
    TransportadoraID INT,
    FOREIGN KEY (FornecedoresID) REFERENCES Fornecedores(FornecedoresID),
    FOREIGN KEY (TransportadoraID) REFERENCES Transportadora(TransportadoraID)
);

CREATE TABLE Vendas (
    VendasID INT PRIMARY KEY AUTO_INCREMENT,
    ProdutosID INT NOT NULL,
    ClientesID INT NOT NULL,
    FOREIGN KEY (ProdutosID) REFERENCES Produtos(ProdutosID),
    FOREIGN KEY (ClientesID) REFERENCES Clientes(ClientesID)
);

CREATE TABLE Funcionarios (
    FuncionariosID INT PRIMARY KEY AUTO_INCREMENT,
    PrimeiroNome VARCHAR(40) NOT NULL,
    SegundoNome VARCHAR(40) NOT NULL,
    DataDeNascimento DATE NOT NULL,
    Foto VARCHAR(150),
    Nota VARCHAR(200),
    VendasID INT,
    FOREIGN KEY (VendasID) REFERENCES Vendas(VendasID)
);

CREATE TABLE Materiais (
    MateriaisID INT PRIMARY KEY AUTO_INCREMENT,
    NomeMaterial VARCHAR(40) NOT NULL,
    FornecedoresID INT,
    FOREIGN KEY (FornecedoresID) REFERENCES Fornecedores(FornecedoresID)
);

