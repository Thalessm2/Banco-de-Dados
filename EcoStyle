-- 1. Vendas com cliente e produto
DELIMITER $$

CREATE PROCEDURE VendasCompletas()
BEGIN
    SELECT v.VendasID, c.Nome AS Cliente, p.Nome AS Produto, p.Preco
    FROM Vendas v
    INNER JOIN Clientes c ON v.ClientesID = c.ClientesID
    INNER JOIN Produtos p ON v.ProdutosID = p.ProdutosID;
END $$

DELIMITER ;

-- 2. Produtos com fornecedores
DELIMITER $$

CREATE PROCEDURE ProdutosFornecedores()
BEGIN
    SELECT p.Nome AS Produto, f.Nome AS Fornecedor
    FROM Produtos p
    INNER JOIN Fornecedores f ON p.FornecedoresID = f.FornecedoresID;
END $$

DELIMITER ;

-- 3. Produtos com transportadora
DELIMITER $$

CREATE PROCEDURE ProdutosTransportadora()
BEGIN
    SELECT p.Nome, t.Nome AS Transportadora
    FROM Produtos p
    INNER JOIN Transportadora t ON p.TransportadoraID = t.TransportadoraID;
END $$

DELIMITER ;

-- 4. Funcionários e vendas
DELIMITER $$

CREATE PROCEDURE FuncionariosVendas()
BEGIN
    SELECT f.PrimeiroNome, f.SegundoNome, v.VendasID
    FROM Funcionarios f
    INNER JOIN Vendas v ON f.VendasID = v.VendasID;
END $$

DELIMITER ;

-- 5. Materiais com fornecedores
DELIMITER $$

CREATE PROCEDURE MateriaisFornecedores()
BEGIN
    SELECT m.NomeMaterial, f.Nome AS Fornecedor
    FROM Materiais m
    INNER JOIN Fornecedores f ON m.FornecedoresID = f.FornecedoresID;
END $$

DELIMITER ;

-- 6. Vendas completas com tudo
DELIMITER $$

CREATE PROCEDURE VendasDetalhadas()
BEGIN
    SELECT v.VendasID, c.Nome AS Cliente, p.Nome AS Produto,
           f.Nome AS Fornecedor
    FROM Vendas v
    INNER JOIN Clientes c ON v.ClientesID = c.ClientesID
    INNER JOIN Produtos p ON v.ProdutosID = p.ProdutosID
    INNER JOIN Fornecedores f ON p.FornecedoresID = f.FornecedoresID;
END $$

DELIMITER ;

-- 7. Média de preço por fornecedor
DELIMITER $$

CREATE PROCEDURE MediaPrecoFornecedor()
BEGIN
    SELECT f.Nome, AVG(p.Preco) AS MediaPreco
    FROM Produtos p
    INNER JOIN Fornecedores f ON p.FornecedoresID = f.FornecedoresID
    GROUP BY f.FornecedoresID;
END $$

DELIMITER ;

