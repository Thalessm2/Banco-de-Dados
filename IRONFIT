-- 1. Listar todos os membros ativos (com subscrição válida)
DELIMITER $$

CREATE PROCEDURE ListarMembrosAtivos()
BEGIN
    SELECT m.Nome, s.Status, s.DataFim
    FROM Membros m
    INNER JOIN Subscricoes s ON m.MembroID = s.MembroID
    WHERE s.Status = 'Ativa';
END $$

DELIMITER ;

-- 2. Buscar histórico de avaliações físicas de um membro
DELIMITER $$

CREATE PROCEDURE HistoricoAvaliacoes(IN idMembro INT)
BEGIN
    SELECT DataAvaliacao, Peso, Altura, IMC
    FROM AvaliacoesFisicas
    WHERE MembroID = idMembro
    ORDER BY DataAvaliacao DESC;
END $$

DELIMITER ;

-- 3. Listar aulas disponíveis com informações do treinador
DELIMITER $$

CREATE PROCEDURE ListarAulas()
BEGIN
    SELECT a.NomeAula, a.DataAula, a.Hora, a.Capacidade, t.Nome AS Trainer
    FROM AulasGrupo a
    INNER JOIN PersonalTrainers t ON a.TrainerID = t.TrainerID;
END $$

DELIMITER ;

-- 4. Verificar sessões de personal de um membro
DELIMITER $$

CREATE PROCEDURE SessoesPorMembro(IN idMembro INT)
BEGIN
    SELECT s.DataSessao, s.Hora, s.Status, t.Nome AS Trainer
    FROM SessoesPersonal s
    INNER JOIN PersonalTrainers t ON s.TrainerID = t.TrainerID
    WHERE s.MembroID = idMembro;
END $$

DELIMITER ;

-- 5. Calcular faturamento total dos planos
DELIMITER $$

CREATE PROCEDURE FaturamentoTotal()
BEGIN
    SELECT SUM(p.Valor) AS TotalFaturado
    FROM Subscricoes s
    INNER JOIN Planos p ON s.PlanoID = p.PlanoID
    WHERE s.Status = 'Ativa';
END $$

DELIMITER ;

-- 6. Listar membros por plano
DELIMITER $$

CREATE PROCEDURE MembrosPorPlano(IN idPlano INT)
BEGIN
    SELECT m.Nome, p.NomePlano
    FROM Membros m
    INNER JOIN Subscricoes s ON m.MembroID = s.MembroID
    INNER JOIN Planos p ON s.PlanoID = p.PlanoID
    WHERE p.PlanoID = idPlano;
END $$

DELIMITER ;

-- 7. Verificar lotação de aulas (quantos inscritos vs capacidade)
DELIMITER $$

CREATE PROCEDURE LotacaoAulas()
BEGIN
    SELECT 
        a.NomeAula,
        a.Capacidade,
        COUNT(ma.MarcacaoID) AS Inscritos
    FROM AulasGrupo a
    LEFT JOIN MarcacoesAulas ma ON a.AulaID = ma.AulaID
    GROUP BY a.AulaID;
END $$
DELIMITER ;
