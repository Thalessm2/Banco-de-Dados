CREATE DATABASE SkyLodge;
USE SkyLodge;


CREATE TABLE Hotel (
    HotelID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(100) NOT NULL,
    CNPJ CHAR(18) NOT NULL UNIQUE,
    Endereco VARCHAR(150) NOT NULL,
    Cidade VARCHAR(50),
    Estado CHAR(2),
    CEP CHAR(9),
    Telefone VARCHAR(20),
    Email VARCHAR(100),
    Site VARCHAR(100)
);


CREATE TABLE Funcionarios (
    FuncionariosID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(100) NOT NULL,
    CPF CHAR(14) UNIQUE,
    Email VARCHAR(100),
    Telefone VARCHAR(20),
    Endereco VARCHAR(150),
    Cargo VARCHAR(50),
    Salario DECIMAL(10,2)
);


CREATE TABLE Clientes (
    ClientesID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(100) NOT NULL,
    CPF CHAR(14) UNIQUE,
    Email VARCHAR(100),
    Telefone VARCHAR(20),
    Endereco VARCHAR(150)
);


CREATE TABLE Categoria (
    CategoriaID INT PRIMARY KEY AUTO_INCREMENT,
    NomeCategoria VARCHAR(50) NOT NULL,
    ValorDiaria DECIMAL(10,2) NOT NULL
);


CREATE TABLE Quartos (
    QuartosID INT PRIMARY KEY AUTO_INCREMENT,
    Numero INT UNIQUE NOT NULL,
    Ocupado BOOLEAN DEFAULT FALSE,
    CategoriaID INT NOT NULL,
    FOREIGN KEY (CategoriaID)
        REFERENCES Categoria(CategoriaID)
);


CREATE TABLE Cadastro (
    CadastroID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(100) NOT NULL,
    CPF CHAR(14) UNIQUE,
    Email VARCHAR(100),
    Telefone VARCHAR(20),
    Endereco VARCHAR(150),
    DataCadastro DATE
);


CREATE TABLE Consumos (
    ConsumosID INT PRIMARY KEY AUTO_INCREMENT,
    Descricao VARCHAR(100),
    Valor DECIMAL(10,2),
    DataConsumo DATE
);


CREATE TABLE Recepcao (
    RecepcaoID INT PRIMARY KEY AUTO_INCREMENT,
    FuncionariosID INT NOT NULL,
    CadastroID INT NOT NULL,
    ConsumosID INT NOT NULL,
    FOREIGN KEY (FuncionariosID)
        REFERENCES Funcionarios(FuncionariosID),
    FOREIGN KEY (CadastroID)
        REFERENCES Cadastro(CadastroID),
    FOREIGN KEY (ConsumosID)
        REFERENCES Consumos(ConsumosID)
);


CREATE TABLE Check_in (
    Check_inID INT PRIMARY KEY AUTO_INCREMENT,
    Agendamento DATE NOT NULL,
    ClientesID INT NOT NULL,
    FOREIGN KEY (ClientesID)
        REFERENCES Clientes(ClientesID)
);


CREATE TABLE Check_out (
    Check_outID INT PRIMARY KEY AUTO_INCREMENT,
    DataDeFinalizacao DATE NOT NULL,
    ClientesID INT NOT NULL,
    FOREIGN KEY (ClientesID)
        REFERENCES Clientes(ClientesID)
);

ALTER TABLE Hotel
ADD DataCriacao DATE;

ALTER TABLE Funcionarios
ADD Status VARCHAR(20) DEFAULT 'Ativo';

ALTER TABLE Clientes
MODIFY Telefone VARCHAR(25);

ALTER TABLE Categoria
ADD Capacidade INT;

ALTER TABLE Quartos
ADD HotelID INT,
ADD FOREIGN KEY (HotelID) REFERENCES Hotel(HotelID);

ALTER TABLE Check_out
ADD FormaPagamento VARCHAR(50);

ALTER TABLE Check_in
CHANGE Agendamento DataCheckIn DATE NOT NULL;

