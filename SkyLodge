-- 1. Check-in com dados do cliente
-- Regra: visualizar entradas no hotel com identificação do cliente

DELIMITER $$

CREATE PROCEDURE CheckInClientes()
BEGIN
    SELECT ci.Check_inID, ci.DataCheckIn, c.Nome, c.CPF
    FROM Check_in ci
    INNER JOIN Clientes c ON ci.ClientesID = c.ClientesID;
END $$

DELIMITER ;

-- 2. Check-out com cliente
-- Regra: controlar saídas e forma de pagamento

DELIMITER $$

CREATE PROCEDURE CheckOutClientes()
BEGIN
    SELECT co.Check_outID, co.DataDeFinalizacao, c.Nome, co.FormaPagamento
    FROM Check_out co
    INNER JOIN Clientes c ON co.ClientesID = c.ClientesID;
END $$

DELIMITER ;

-- 3. Quartos com categoria
-- Regra: mostrar tipo de quarto e valor

DELIMITER $$

CREATE PROCEDURE QuartosCategoria()
BEGIN
    SELECT q.Numero, q.Ocupado, cat.NomeCategoria, cat.ValorDiaria
    FROM Quartos q
    INNER JOIN Categoria cat ON q.CategoriaID = cat.CategoriaID;
END $$

DELIMITER ;

-- 4. Quartos com hotel
-- Regra: visualizar estrutura do hotel

DELIMITER $$

CREATE PROCEDURE QuartosHotel()
BEGIN
    SELECT q.Numero, h.Nome AS Hotel, h.Cidade
    FROM Quartos q
    INNER JOIN Hotel h ON q.HotelID = h.HotelID;
END $$

DELIMITER ;

-- 5. Recepção completa
-- Regra: integrar funcionário + cadastro + consumo

DELIMITER $$

CREATE PROCEDURE RecepcaoCompleta()
BEGIN
    SELECT f.Nome AS Funcionario,
           c.Nome AS Cliente,
           cons.Descricao,
           cons.Valor
    FROM Recepcao r
    INNER JOIN Funcionarios f ON r.FuncionariosID = f.FuncionariosID
    INNER JOIN Cadastro c ON r.CadastroID = c.CadastroID
    INNER JOIN Consumos cons ON r.ConsumosID = cons.ConsumosID;
END $$

DELIMITER ;

-- 6. Consumo total por cliente
-- Regra: calcular gastos durante estadia

DELIMITER $$

CREATE PROCEDURE ConsumoPorCliente()
BEGIN
    SELECT c.Nome, SUM(cons.Valor) AS TotalGasto
    FROM Recepcao r
    INNER JOIN Cadastro c ON r.CadastroID = c.CadastroID
    INNER JOIN Consumos cons ON r.ConsumosID = cons.ConsumosID
    GROUP BY c.CadastroID;
END $$

DELIMITER ;

-- 7. Clientes com check-in e check-out
-- Regra: histórico completo da estadia

DELIMITER $$

CREATE PROCEDURE HistoricoClientes()
BEGIN
    SELECT c.Nome,
           ci.DataCheckIn,
           co.DataDeFinalizacao
    FROM Clientes c
    INNER JOIN Check_in ci ON c.ClientesID = ci.ClientesID
    INNER JOIN Check_out co ON c.ClientesID = co.ClientesID;
END $$

DELIMITER ;

