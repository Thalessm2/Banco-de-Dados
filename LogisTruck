-- 1. Listar todas as entregas com informações completas
-- Regra: Mostrar dados integrados (caminhão, motorista, cliente e rota)
DELIMITER $$

CREATE PROCEDURE ListarEntregasCompletas()
BEGIN
    SELECT e.EntregaID, c.Placa, m.Nome AS Motorista, cl.RazaoSocial, 
           r.Origem, r.Destino, e.DataEntrega, e.Status
    FROM Entregas e
    INNER JOIN Caminhoes c ON e.CaminhaoID = c.CaminhaoID
    INNER JOIN Motoristas m ON e.MotoristaID = m.MotoristaID
    INNER JOIN Clientes cl ON e.ClienteID = cl.ClienteID
    INNER JOIN Rotas r ON e.RotaID = r.RotaID;
END $$

DELIMITER ;

-- 2. Buscar entregas por cliente
-- Regra: Permitir consultar histórico de entregas de um cliente específico
DELIMITER $$

CREATE PROCEDURE EntregasPorCliente(IN idCliente INT)
BEGIN
    SELECT e.EntregaID, e.DataEntrega, e.Status
    FROM Entregas e
    WHERE e.ClienteID = idCliente;
END $$

DELIMITER ;

-- 3. Listar entregas por motorista
-- Regra: Acompanhar desempenho dos motoristas
DELIMITER $$

CREATE PROCEDURE EntregasPorMotorista(IN idMotorista INT)
BEGIN
    SELECT e.EntregaID, e.DataEntrega, e.Status
    FROM Entregas e
    WHERE e.MotoristaID = idMotorista;
END $$

DELIMITER ;

-- 4. Calcular total gasto com combustível por caminhão
-- Regra: Controle de custos operacionais
DELIMITER $$

CREATE PROCEDURE GastoCombustivelPorCaminhao()
BEGIN
    SELECT c.Placa, SUM(cc.ValorTotal) AS TotalGasto
    FROM Caminhoes c
    INNER JOIN ConsumoCombustivel cc ON c.CaminhaoID = cc.CaminhaoID
    GROUP BY c.CaminhaoID;
END $$

DELIMITER ;

-- 5. Calcular total gasto com manutenção por caminhão
-- Regra: Monitorar custos de manutenção da frota
DELIMITER $$

CREATE PROCEDURE GastoManutencaoPorCaminhao()
BEGIN
    SELECT c.Placa, SUM(m.Custo) AS TotalManutencao
    FROM Caminhoes c
    INNER JOIN Manutencoes m ON c.CaminhaoID = m.CaminhaoID
    GROUP BY c.CaminhaoID;
END $$

DELIMITER ;

-- 6. Listar rotas mais longas (acima de um valor informado)
-- Regra: Identificar rotas de maior distância
DELIMITER $$

CREATE PROCEDURE RotasLongas(IN distanciaMin DECIMAL(8,2))
BEGIN
    SELECT Origem, Destino, DistanciaKM
    FROM Rotas
    WHERE DistanciaKM > distanciaMin;
END $$

DELIMITER ;

-- 7. Verificar quantidade de entregas por status
-- Regra: Controle operacional (pendente, entregue, etc.)
DELIMITER $$

CREATE PROCEDURE EntregasPorStatus()
BEGIN
    SELECT Status, COUNT(*) AS Quantidade
    FROM Entregas
    GROUP BY Status;
END $$

DELIMITER ;
