CREATE DATABASE LogisTruck;
USE LogisTruck;

CREATE TABLE Caminhoes (
    CaminhaoID INT PRIMARY KEY AUTO_INCREMENT,
    Placa VARCHAR(10) UNIQUE NOT NULL,
    Modelo VARCHAR(50) NOT NULL,
    Marca VARCHAR(40) NOT NULL,
    AnoFabricacao INT NOT NULL,
    CapacidadeCarga DECIMAL(10,2) NOT NULL
);

CREATE TABLE Motoristas (
    MotoristaID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(50) NOT NULL,
    DataNascimento DATE NOT NULL,
    Telefone VARCHAR(20),
    Email VARCHAR(50),
    CNH VARCHAR(20) UNIQUE NOT NULL
);

CREATE TABLE Clientes (
    ClienteID INT PRIMARY KEY AUTO_INCREMENT,
    RazaoSocial VARCHAR(60) NOT NULL,
    CNPJ VARCHAR(14) UNIQUE NOT NULL,
    Telefone VARCHAR(20),
    Cidade VARCHAR(40),
    Email VARCHAR(50)
);

CREATE TABLE Rotas (
    RotaID INT PRIMARY KEY AUTO_INCREMENT,
    Origem VARCHAR(50) NOT NULL,
    Destino VARCHAR(50) NOT NULL,
    DistanciaKM DECIMAL(8,2) NOT NULL
);

CREATE TABLE Entregas (
    EntregaID INT PRIMARY KEY AUTO_INCREMENT,
    CaminhaoID INT NOT NULL,
    MotoristaID INT NOT NULL,
    ClienteID INT NOT NULL,
    RotaID INT NOT NULL,
    DataEntrega DATE NOT NULL,
    Status VARCHAR(30),
    FOREIGN KEY (CaminhaoID) REFERENCES Caminhoes(CaminhaoID),
    FOREIGN KEY (MotoristaID) REFERENCES Motoristas(MotoristaID),
    FOREIGN KEY (ClienteID) REFERENCES Clientes(ClienteID),
    FOREIGN KEY (RotaID) REFERENCES Rotas(RotaID)
);

CREATE TABLE Manutencoes (
    ManutencaoID INT PRIMARY KEY AUTO_INCREMENT,
    CaminhaoID INT NOT NULL,
    DataManutencao DATE NOT NULL,
    TipoManutencao VARCHAR(50),
    Custo DECIMAL(10,2),
    FOREIGN KEY (CaminhaoID) REFERENCES Caminhoes(CaminhaoID)
);

CREATE TABLE ConsumoCombustivel (
    ConsumoID INT PRIMARY KEY AUTO_INCREMENT,
    CaminhaoID INT NOT NULL,
    DataAbastecimento DATE NOT NULL,
    Litros DECIMAL(8,2) NOT NULL,
    ValorTotal DECIMAL(10,2) NOT NULL,
    Quilometragem INT NOT NULL,
    FOREIGN KEY (CaminhaoID) REFERENCES Caminhoes(CaminhaoID)
);
ALTER TABLE Caminhoes
ADD Cor VARCHAR(30);

ALTER TABLE Motoristas
ADD Salario DECIMAL(10,2);

ALTER TABLE Clientes
ADD Endereco VARCHAR(100);

ALTER TABLE Rotas
ADD TempoEstimado TIME;

ALTER TABLE Entregas
ADD PesoCarga DECIMAL(10,2);

ALTER TABLE Manutencoes
ADD Oficina VARCHAR(50);

ALTER TABLE ConsumoCombustivel
ADD TipoCombustivel VARCHAR(20);

