USE MedPet;

DELIMITER $$

CREATE PROCEDURE sp_CadastrarCliente (
    IN p_CustomerName   VARCHAR(50),
    IN p_Email          VARCHAR(150),
    IN p_Phone          VARCHAR(15),
    IN p_Password       VARCHAR(150)
)

BEGIN
    DECLARE v_existentes INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    -- Subquery para verificar duplicidade de email ou telefone
    SELECT COUNT(*) INTO v_existentes
    FROM Customer
    WHERE Email = p_Email OR Phone = p_Phone;

    START TRANSACTION;

    IF v_existentes > 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Ja existe um cliente cadastrado com este email ou telefone.';
    ELSE
        INSERT INTO Customer (CustomerName, Email, Phone, PasswordCustomer, RegistrationDate)
        VALUES (p_CustomerName, p_Email, p_Phone, p_Password, CURDATE());
        COMMIT;
    END IF;
END$$
DELIMITER ;


DELIMITER $$

CREATE PROCEDURE sp_CadastrarPet (
    IN p_PetName    VARCHAR(100),
    IN p_Age        VARCHAR(4),
    IN p_Gender     VARCHAR(15),
    IN p_Animal     VARCHAR(50),
    IN p_Race       VARCHAR(150),
    IN p_CustomerID INT,
    IN p_Weight     DECIMAL(5,2)
)

BEGIN
    DECLARE v_cliente_existe INT DEFAULT 0;
    DECLARE v_size VARCHAR(20);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    SELECT COUNT(*) INTO v_cliente_existe
    FROM Customer
    WHERE CustomerID = p_CustomerID;

    START TRANSACTION;

    IF v_cliente_existe = 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Cliente informado nao existe no cadastro.';
    ELSE
        -- Classificacao automatica de porte com base no peso
        IF p_Weight <= 10 THEN
            SET v_size = 'Pequeno';
        ELSEIF p_Weight <= 25 THEN
            SET v_size = 'Medio';
        ELSE
            SET v_size = 'Grande';
        END IF;

        INSERT INTO Pet (PetName, Age, Gender, Animal, Race, Size, CustomerID, Weight)
        VALUES (p_PetName, p_Age, p_Gender, p_Animal, p_Race, v_size, p_CustomerID, p_Weight);

        COMMIT;
    END IF;
END$$
DELIMITER ;


DELIMITER $$

CREATE PROCEDURE sp_AgendarConsulta (
    IN p_PetID          INT,
    IN p_SchedulingDate DATE,
    IN p_SchedulingHour TIME
)

BEGIN
    DECLARE v_pet_existe   INT DEFAULT 0;
    DECLARE v_conflito     INT DEFAULT 0;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    SELECT COUNT(*) INTO v_pet_existe
    FROM Pet
    WHERE PetID = p_PetID;

    -- Subquery: verifica se ja existe agendamento ativo no mesmo dia/hora
    SELECT COUNT(*) INTO v_conflito
    FROM Scheduling
    WHERE SchedulingDate = p_SchedulingDate
      AND SchedulingHour = p_SchedulingHour
      AND StatusPet IN ('Agendado', 'Confirmado');

    START TRANSACTION;

    IF v_pet_existe = 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Pet informado nao existe no cadastro.';
    ELSEIF v_conflito > 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Ja existe um agendamento neste mesmo dia e horario.';
    ELSE
        INSERT INTO Scheduling (SchedulingDate, SchedulingHour, PetID, StatusPet)
        VALUES (p_SchedulingDate, p_SchedulingHour, p_PetID, 'Agendado');
        COMMIT;
    END IF;
END$$
DELIMITER ;


DELIMITER $$

CREATE PROCEDURE sp_RegistrarConsulta (
    IN p_SchedulingID   INT,
    IN p_AppointmentValue DECIMAL(10,2),
    IN p_VeterinarianName VARCHAR(150)
)

BEGIN
    DECLARE v_status_atual VARCHAR(30);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    SELECT StatusPet INTO v_status_atual
    FROM Scheduling
    WHERE SchedulingID = p_SchedulingID;

    START TRANSACTION;

    IF v_status_atual IS NULL THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Agendamento informado nao existe.';
    ELSEIF v_status_atual = 'Cancelado' THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Nao e possivel registrar consulta de um agendamento cancelado.';
    ELSE
        INSERT INTO Appointment (AppointmentValue, SchedulingID, VeterinarianName)
        VALUES (p_AppointmentValue, p_SchedulingID, p_VeterinarianName);

        UPDATE Scheduling
        SET StatusPet = 'Concluido'
        WHERE SchedulingID = p_SchedulingID;

        COMMIT;
    END IF;
END$$
DELIMITER ;


DELIMITER $$

CREATE PROCEDURE sp_GerarFatura (
    IN p_AppointmentID INT,
    IN p_PaymentMethod VARCHAR(50)
)

BEGIN
    DECLARE v_valor_consulta   DECIMAL(10,2);
    DECLARE v_qtd_faturas_ant  INT DEFAULT 0;
    DECLARE v_valor_final      DECIMAL(10,2);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    SELECT AppointmentValue INTO v_valor_consulta
    FROM Appointment
    WHERE AppointmentID = p_AppointmentID;

    -- Conta quantas faturas o cliente (dono do pet desta consulta) ja pagou,
    -- percorrendo o relacionamento Billing -> Appointment -> Scheduling -> Pet -> Customer
    SELECT COUNT(*) INTO v_qtd_faturas_ant
    FROM Billing b
    JOIN Appointment a ON b.AppointmentID = a.AppointmentID
    JOIN Scheduling s  ON a.SchedulingID  = s.SchedulingID
    JOIN Pet p         ON s.PetID         = p.PetID
    WHERE p.CustomerID = (
        SELECT p2.CustomerID
        FROM Appointment a2
        JOIN Scheduling s2 ON a2.SchedulingID = s2.SchedulingID
        JOIN Pet p2        ON s2.PetID        = p2.PetID
        WHERE a2.AppointmentID = p_AppointmentID
    );

    START TRANSACTION;

    IF v_valor_consulta IS NULL THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Consulta (Appointment) informada nao existe.';
    ELSE
        IF v_qtd_faturas_ant >= 5 THEN
            SET v_valor_final = v_valor_consulta * 0.90; -- 10% de desconto fidelidade
        ELSE
            SET v_valor_final = v_valor_consulta;
        END IF;

        INSERT INTO Billing (AmountRaised, SalesMade, AppointmentID, PaymentMethod)
        VALUES (v_valor_final, v_qtd_faturas_ant + 1, p_AppointmentID, p_PaymentMethod);

        COMMIT;
    END IF;
END$$
DELIMITER ;


DELIMITER $$

CREATE PROCEDURE sp_RegistrarHistoricoMedico (
    IN p_PetID          INT,
    IN p_Consultations  TEXT,
    IN p_Diagnosis      VARCHAR(200),
    IN p_Tests          VARCHAR(200),
    IN p_Vaccines       VARCHAR(100),
    IN p_Procedures     VARCHAR(150),
    IN p_Allergies      VARCHAR(100),
    IN p_Observations   VARCHAR(300),
    IN p_Weight         DECIMAL(5,2)
)

BEGIN
    DECLARE v_pet_existe        INT DEFAULT 0;
    DECLARE v_observacao_final  VARCHAR(300);

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    SELECT COUNT(*) INTO v_pet_existe
    FROM Pet
    WHERE PetID = p_PetID;

    START TRANSACTION;

    IF v_pet_existe = 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Pet informado nao existe no cadastro.';
    ELSE
        -- Se o pet tem alergia a medicamento registrada, adiciona alerta automatico
        IF p_Allergies LIKE '%medicamento%' THEN
            SET v_observacao_final = CONCAT(p_Observations,
                ' | ALERTA: paciente possui alergia a medicamento, revisar antes de aplicar vacinas/procedimentos.');
        ELSE
            SET v_observacao_final = p_Observations;
        END IF;

        INSERT INTO MedicalHistory (
            Consultations, Diagnosis, Tests, Vaccines, Procedures,
            Allergies, ClinicalObservations, PetID, Weight
        )
        VALUES (
            p_Consultations, p_Diagnosis, p_Tests, p_Vaccines, p_Procedures,
            p_Allergies, v_observacao_final, p_PetID, p_Weight
        );

        COMMIT;
    END IF;
END$$
DELIMITER ;


DELIMITER $$

CREATE PROCEDURE sp_InternarPaciente (
    IN p_MedicalHistoryID   INT,
    IN p_Date_Of_Entry      DATE,
    IN p_Check_in_time      TIME,
    IN p_DischargeDate      DATE,
    IN p_DischargeTime      TIME,
    IN p_ReasonForAdmission VARCHAR(250),
    IN p_Diagnosis          TEXT,
    IN p_Tests              VARCHAR(200),
    IN p_AttendingVet       VARCHAR(150)
)

BEGIN
    DECLARE v_hist_existe   INT DEFAULT 0;
    DECLARE v_dias_internado INT;
    DECLARE v_diagnostico_final TEXT;

    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    SELECT COUNT(*) INTO v_hist_existe
    FROM MedicalHistory
    WHERE MedicalHistoryID = p_MedicalHistoryID;

    SET v_dias_internado = DATEDIFF(p_DischargeDate, p_Date_Of_Entry);

    START TRANSACTION;

    IF v_hist_existe = 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'Historico medico informado nao existe.';
    ELSEIF v_dias_internado < 0 THEN
        SIGNAL SQLSTATE '45000'
        SET MESSAGE_TEXT = 'A data de alta nao pode ser anterior a data de entrada.';
    ELSE
        IF v_dias_internado > 5 THEN
            SET v_diagnostico_final = CONCAT(p_Diagnosis, ' | Internacao prolongada (', v_dias_internado, ' dias).');
        ELSE
            SET v_diagnostico_final = p_Diagnosis;
        END IF;

        INSERT INTO HospitalizedPatients (
            Date_Of_Entry, Check_in_time, DischargeDate, DischargeTime,
            ReasonForAdmission, Diagnosis, Tests, MedicalHistoryID, AttendingVeterinarian
        )
        VALUES (
            p_Date_Of_Entry, p_Check_in_time, p_DischargeDate, p_DischargeTime,
            p_ReasonForAdmission, v_diagnostico_final, p_Tests, p_MedicalHistoryID, p_AttendingVet
        );

        COMMIT;
    END IF;
END$$
DELIMITER ;
