CREATE DATABASE MedPet;
USE MedPet;

CREATE TABLE Customer (
CustomerID INT PRIMARY KEY AUTO_INCREMENT,
CustomerName VARCHAR (50) NOT NULL,
Email VARCHAR (150) NOT NULL,
CONSTRAINT uc_email UNIQUE (Email),
Phone VARCHAR (15) NOT NULL,
CONSTRAINT uc_phone UNIQUE (Phone),
PasswordCustomer VARCHAR (150) NOT NULL
);

CREATE TABLE Pet (
PetID INT PRIMARY KEY AUTO_INCREMENT,
PetName VARCHAR (100) NOT NULL,
Age VARCHAR (4) NOT NULL,
Gender VARCHAR (15) NOT NULL,
Animal VARCHAR (50) NOT NULL,
Race VARCHAR (150) NOT NULL,
Size VARCHAR (20) NOT NULL,
CustomerID INT,
    FOREIGN KEY (CustomerID) 
    REFERENCES Customer (CustomerID)
);

CREATE TABLE Scheduling (
SchedulingID INT PRIMARY KEY AUTO_INCREMENT,
SchedulingDate DATE NOT NULL,
SchedulingHour TIME NOT NULL,
PetID INT,
    FOREIGN KEY (PetID)
    REFERENCES Pet (PetID)
);

CREATE TABLE Appointment (
 AppointmentID INT PRIMARY KEY AUTO_INCREMENT,
AppointmentValue DECIMAL,
SchedulingID INT,
    FOREIGN KEY (SchedulingID)
    REFERENCES Scheduling (SchedulingID)
);

CREATE TABLE Billing (
BillingID INT PRIMARY KEY AUTO_INCREMENT,
AmountRaised DECIMAL,
SalesMade INT (200),
AppointmentID INT,
	FOREIGN KEY (AppointmentID)
    REFERENCES Appointment (AppointmentID)
);

CREATE TABLE MedicalHistory (
MedicalHistoryID INT PRIMARY KEY AUTO_INCREMENT,
Consultations TEXT NOT NULL,
Diagnosis VARCHAR (200) NOT NULL,
Tests VARCHAR (200) NOT NULL,
Vaccines VARCHAR (100) NOT NULL,
Procedures VARCHAR (150) NOT NULL,
Allergies VARCHAR (100) NOT NULL,
ClinicalObservations VARCHAR (300) NOT NULL,
PetID INT,
    FOREIGN KEY (PetID)
    REFERENCES Pet (PetID)
);

CREATE TABLE HospitalizedPatients (
HospitalizedPatientsID INT PRIMARY KEY AUTO_INCREMENT,
Date_Of_Entry DATE NOT NULL,
Check_in_time TIME NOT NULL,
DischargeDate DATE NOT NULL,
DischargeTime TIME NOT NULL,
ReasonForAdmission VARCHAR (250) NOT NULL,
Diagnosis TEXT NOT NULL,
Tests VARCHAR (200) NOT NULL,
MedicalHistoryID INT,
     FOREIGN KEY (MedicalHistoryID)
    REFERENCES MedicalHistory (MedicalHistoryID)
);

ALTER TABLE Customer
ADD COLUMN RegistrationDate DATE NOT NULL;

ALTER TABLE Pet
ADD COLUMN Weight DECIMAL(5,2);

ALTER TABLE Scheduling
ADD COLUMN StatusPet VARCHAR(30) NOT NULL DEFAULT 'Agendado';

ALTER TABLE Appointment
ADD COLUMN VeterinarianName VARCHAR(150);

ALTER TABLE Billing
ADD COLUMN PaymentMethod VARCHAR(50);

ALTER TABLE MedicalHistory
ADD COLUMN Weight DECIMAL(5,2);

ALTER TABLE HospitalizedPatients
ADD COLUMN AttendingVeterinarian VARCHAR(150);

 
