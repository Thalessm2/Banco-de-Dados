-- 1. Listar todos os pedidos com informações completas
-- Regra: Integrar cliente, entregador e itens do pedido
DELIMITER $$

CREATE PROCEDURE PedidosCompletos()
BEGIN
    SELECT p.PedidoID, p.DataDoPedido, c.Nome AS Cliente,
           e.Nome AS Entregador, m.Pratos, m.Valor, p.StatusPedido
    FROM Pedidos p
    INNER JOIN Clientes c ON p.ClientesID = c.ClientesID
    INNER JOIN Entregadores e ON p.EntregadoreID = e.EntregadoreID
    INNER JOIN Menu m ON p.MenuID = m.MenuID;
END $$

DELIMITER ;

-- 2. Buscar pedidos por cliente
-- Regra: Permitir histórico de compras
DELIMITER $$

CREATE PROCEDURE PedidosPorCliente(IN idCliente INT)
BEGIN
    SELECT PedidoID, DataDoPedido, StatusPedido
    FROM Pedidos
    WHERE ClientesID = idCliente;
END $$

DELIMITER ;

-- 3. Calcular faturamento total do restaurante
-- Regra: Somar valores dos pedidos realizados
DELIMITER $$

CREATE PROCEDURE FaturamentoTotal()
BEGIN
    SELECT SUM(m.Valor) AS TotalFaturado
    FROM Pedidos p
    INNER JOIN Menu m ON p.MenuID = m.MenuID;
END $$

DELIMITER ;

-- 4. Listar entregas por entregador
-- Regra: Acompanhar desempenho dos entregadores
DELIMITER $$

CREATE PROCEDURE EntregasPorEntregador(IN idEntregador INT)
BEGIN
    SELECT p.PedidoID, p.DataDoPedido, p.StatusPedido
    FROM Pedidos p
    WHERE p.EntregadoreID = idEntregador;
END $$

DELIMITER ;

-- 5. Listar menu por categoria
-- Regra: Filtrar itens do cardápio
DELIMITER $$

CREATE PROCEDURE MenuPorCategoria(IN cat VARCHAR(40))
BEGIN
    SELECT Pratos, Bebidas, Sobremesas, Valor
    FROM Menu
    WHERE Categoria = cat;
END $$

DELIMITER ;

-- 6. Listar avaliações de clientes
-- Regra: Monitorar satisfação dos clientes
DELIMITER $$

CREATE PROCEDURE AvaliacoesClientes()
BEGIN
    SELECT c.Nome, a.Nota, a.Sugestao
    FROM Avaliacao a
    INNER JOIN Clientes c ON a.ClientesID = c.ClientesID;
END $$

DELIMITER ;

-- 7. Verificar cupons válidos
-- Regra: Mostrar apenas cupons dentro da validade
DELIMITER $$

CREATE PROCEDURE CuponsValidos()
BEGIN
    SELECT CupomID, Desconto, DataValidade
    FROM Cupons
    WHERE DataValidade >= CURDATE();
END $$

DELIMITER ;

