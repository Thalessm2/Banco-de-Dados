CREATE DATABASE FastBite;
USE FastBite;

CREATE TABLE Restaurante (
    RestauranteID INT PRIMARY KEY AUTO_INCREMENT,
    CNPJ VARCHAR(14) UNIQUE NOT NULL,
    Nome VARCHAR(50) NOT NULL,
    Endereco VARCHAR(70) NOT NULL
);

CREATE TABLE Clientes (
    ClientesID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(40) NOT NULL,
    Telefone VARCHAR(20) NOT NULL,
    Endereco VARCHAR(40) NOT NULL,
    Cidade VARCHAR(40) NOT NULL,
    Pais VARCHAR(40) NOT NULL
);

CREATE TABLE Menu (
    MenuID INT PRIMARY KEY AUTO_INCREMENT,
    Pratos VARCHAR(60) NOT NULL,
    Bebidas VARCHAR(50) NOT NULL,
    Sobremesas VARCHAR(60) NOT NULL,
    Valor DECIMAL(10,2) NOT NULL,
    ClientesID INT NOT NULL,
    RestauranteID INT NOT NULL,
    FOREIGN KEY (ClientesID) REFERENCES Clientes(ClientesID),
    FOREIGN KEY (RestauranteID) REFERENCES Restaurante(RestauranteID)
);

CREATE TABLE Funcionarios (
    FuncionarioID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(70) NOT NULL,
    DataDeNascimento DATE NOT NULL,
    Telefone VARCHAR(20) NOT NULL,
    Endereco VARCHAR(40),
    Email VARCHAR(40),
    MenuID INT NOT NULL,
    FOREIGN KEY (MenuID) REFERENCES Menu(MenuID)
);

CREATE TABLE Entregadores (
    EntregadoreID INT PRIMARY KEY AUTO_INCREMENT,
    Nome VARCHAR(50) NOT NULL,
    Placa VARCHAR(10) NOT NULL,
    CPF VARCHAR(11) NOT NULL,
    Veiculo VARCHAR(60) NOT NULL
);

CREATE TABLE Pedidos (
    PedidoID INT PRIMARY KEY AUTO_INCREMENT,
    DataDoPedido DATE NOT NULL,
    MenuID INT NOT NULL,
    EntregadoreID INT NOT NULL,
    ClientesID INT NOT NULL,
    FOREIGN KEY (MenuID) REFERENCES Menu(MenuID),
    FOREIGN KEY (EntregadoreID) REFERENCES Entregadores(EntregadoreID),
    FOREIGN KEY (ClientesID) REFERENCES Clientes(ClientesID)
);

CREATE TABLE Avaliacao (
    AvaliacaoID INT PRIMARY KEY AUTO_INCREMENT,
    Nota VARCHAR(90),
    Sugestao VARCHAR(80),
    ClientesID INT NOT NULL,
    FOREIGN KEY (ClientesID) REFERENCES Clientes(ClientesID)
);

CREATE TABLE Cupons (
    CupomID INT PRIMARY KEY AUTO_INCREMENT,
    Desconto VARCHAR(60),
    MenuID INT NOT NULL,
    FOREIGN KEY (MenuID) REFERENCES Menu(MenuID)
);
ALTER TABLE Restaurante
ADD Email VARCHAR(50);

ALTER TABLE Clientes
ADD CPF VARCHAR(11);

ALTER TABLE Menu
ADD Categoria VARCHAR(40);

ALTER TABLE Funcionarios
ADD Salario DECIMAL(10,2);

ALTER TABLE Entregadores
ADD Telefone VARCHAR(20);

ALTER TABLE Pedidos
ADD StatusPedido VARCHAR(30);

ALTER TABLE Cupons
ADD DataValidade DATE;

